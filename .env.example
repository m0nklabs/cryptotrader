# Example environment file (DO NOT put real secrets here)

# Bitfinex API Credentials
BITFINEX_API_KEY_MAIN=
BITFINEX_API_SECRET_MAIN=
BITFINEX_API_KEY_SUB=
BITFINEX_API_SECRET_SUB=
BITFINEX_API_KEY_TEST=
BITFINEX_API_SECRET_TEST=
BITFINEX_TOTP_SECRET=

# Optional aliases (the Bitfinex REST client will also read these)
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# API Settings
BITFINEX_TIMEOUT=30
BITFINEX_RATE_LIMIT=90
BITFINEX_ENVIRONMENT=production

# Optional email integration (use app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional database for indicator weights/signals and persistence
# This should be set via GitHub repository secret: DATABASE_URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Optional local Docker Compose Postgres defaults (compose dev stack only).
# The live deployment uses DATABASE_URL above against the cryptotrader-postgres
# container on 127.0.0.1:50432, database `cryptotrader`.
DB_PORT=50432
DB_DATA_PATH=/home/flip/postgres_data/shared
DB_NAME=cryptotrader_dev
DB_USER=cryptotrader
DB_PASSWORD=cryptotrader

# Frontend dev/preview server (vite): PORT = backend port the vite proxy
# targets, FRONTEND_PORT = the port the dev/preview server binds.
PORT=8000
FRONTEND_PORT=5176

# Optional Ollama (LLM) configuration for signals/dossier
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_USER=
OLLAMA_PASSWORD=

# Guardian (llama_cpp_guardian) proxy — REQUIRED for Guardian-backed LLM features
# (GuardianAnalyst, Multi-Brain roles, health checks, /v1/models).
# When absent, Guardian features short-circuit (no unauthenticated polling).
# Set to any non-empty string to enable; value is used as Bearer token.
GUARDIAN_API_KEY=
GUARDIAN_HOST=http://localhost:11434
GUARDIAN_DEFAULT_MODEL=GLM-4.7-Flash

# Optional Multi-Brain AI provider keys (Phase 1+)
# IMPORTANT: do not commit real keys. Use env vars in your runtime or CI secrets.
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter recommended headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Optional dossier debug logging
DOSSIER_DEBUG=false

# Signal Alerts (opt-in, disabled by default)
SIGNAL_ALERTS_ENABLED=false
SIGNAL_WEBHOOK_URL=

# Candle Ingestion
# Standard timeframes: 1m, 5m, 15m, 1h, 4h, 1d
# The multi-timeframe ingestion script uses these by default
TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Forecasting (TimesFM) — optional extra; requires: pip install -r requirements-forecast.txt
# Hugging Face model id; default is TimesFM 3.0 (non-commercial weights, local evaluation only)
TIMESFM_MODEL_ID=google/timesfm-3.0-pytorch
# Backend selection: auto | timesfm2_5 | timesfm3 (auto derives the backend from the model id)
TIMESFM_BACKEND=auto
# Inference device: auto | cpu | cuda (auto pre-checks free VRAM before using the GPU)
TIMESFM_DEVICE=auto
# Maximum context length in candles fed to the model
TIMESFM_MAX_CONTEXT=1024
# Maximum forecast horizon (steps ahead)
TIMESFM_MAX_HORIZON=256
# Forecast cache entry lifetime in seconds (cache is keyed on the last closed candle)
TIMESFM_CACHE_TTL=1800
# 1 = preload the model at API startup, 0 = lazy-load on the first forecast request
TIMESFM_PRELOAD=1
# On-demand hosting: drop the model from memory after this many seconds
# without a successful forecast (0 = disabled, model stays resident until
# process exit). The next forecast request transparently reloads (~2-7 s on
# CPU). Recommended: 900 (15 min) so an idle API holds zero model memory.
TIMESFM_IDLE_UNLOAD=900
