[Unit]
Description=CryptoTrader API (FastAPI backend)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=%h/cryptotrader

# Load environment from .env file (includes DATABASE_URL, API keys, GUARDIAN_API_KEY)
EnvironmentFile=%h/cryptotrader/.env

# DATABASE_URL comes from %h/cryptotrader/.env (live DB on 127.0.0.1:50432/cryptotrader).
# GUARDIAN_API_KEY is required for Guardian-backed LLM features (GuardianAnalyst, Multi-Brain).
# When absent, Guardian features short-circuit rather than polling unauthenticated.
Environment=PYTHONPATH=%h/cryptotrader

# --timeout-graceful-shutdown: never let a stop hang >15 s (systemd would wait
# 90 s and SIGKILL; observed 2026-09-06, journal "stop-sigterm timed out").
ExecStart=%h/cryptotrader/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 15
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
